# ==========================================
# IMovies Frontend Environment Variables
# ==========================================

# Backend API URL
# Local Development: leave blank to use Vite /api proxy (http://localhost:5000)
# Deployed Backend on Render: https://imovies-api.onrender.com (or with /api)
# Deployed Monorepo on Vercel: leave blank or set to your Vercel domain
VITE_API_URL=http://localhost:5000
